{
  "name": "survey-forge",
  "private": true,
  "version": "1.0.0",
  "description": "Create, share and analyse surveys. React + Firebase + Bootstrap.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && npx firebase-tools deploy",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.4",
    "chart.js": "^4.5.1",
    "docx": "^9.7.1",
    "firebase": "^10.14.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
